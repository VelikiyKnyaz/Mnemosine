# Solo configuración publicable del cliente. EXPO_PUBLIC_ se incluye en la app.
EXPO_PUBLIC_SUPABASE_URL=
# Preferir la publishable key en proyectos nuevos; anon es la alternativa heredada.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Nunca service_role ni una clave secreta de Supabase.
# OpenAI y Google Places/Geocoding necesitan secretos en un backend autenticado.
# Configurarlos en Supabase Edge Functions → Secrets, sin EXPO_PUBLIC_.
