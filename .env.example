# Solo configuración publicable del cliente. EXPO_PUBLIC_ se incluye en la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Usar la clave anon, nunca service_role ni una clave secreta de Supabase.
# OpenAI y Google Places/Geocoding necesitan secretos en un backend autenticado.
# Esa migración sigue pendiente: no añadir sus claves privadas a este archivo.
